# --- Database ---
POSTGRES_USER=factlens
POSTGRES_PASSWORD=factlens
POSTGRES_DB=factlens
DATABASE_URL=postgresql+psycopg2://factlens:factlens@db:5432/factlens
# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
CORS_ORIGINS=http://localhost:5173
# Optional: first admin account created on startup
ADMIN_EMAIL=admin@factlens.dev
ADMIN_PASSWORD=change-this-admin-password
# --- Frontend ---
VITE_API_URL=http://localhost:8000
# Optional Google Fact Check Tools API credential
GOOGLE_FACT_CHECK_API_KEY=
# Optional 2020+ training CSV; must contain text/title plus label/date columns
FACTLENS_NEW_DATA_CSV=
